# Copy to .env and fill in values before running

# Redis machine: Tailscale IP to bind Redis on (not 0.0.0.0)
REDIS_BIND=100.x.x.x

# Shared Redis password — must match what's in config.json / watcher.json
REDIS_PASSWORD=changeme

# Override if pterodactyl volumes are at a non-default path (GorillaServer nodes)
# PTERODACTYL_VOLUMES=/var/lib/pterodactyl/volumes
